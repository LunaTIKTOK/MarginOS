# Copy to .env and fill in. Never commit a real .env.
# Database: SQLite file by default; Postgres URL for production, e.g.
# postgresql+psycopg2://user:pass@host:5432/marginos
DATABASE_URL=sqlite:///./data/marginos.db
SECRET_KEY=change-me-to-a-long-random-string
# Stripe TEST keys only (sandbox). Leave empty to run billing in
# "not configured" mode — the app never requires live keys.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=
